# 複製此檔為 .env 並填入你的 OpenRouter API key
# 申請位置: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter 模型；命令列 --model 可優先覆蓋
OPENROUTER_MODEL=google/gemini-3.8-flash

# 報告連結：本機工作目錄對應的網路分享；不影響實際讀檔與歸檔
REPORT_LOCAL_ROOT=C:\public
REPORT_SHARE_ROOT=\\192.168.1.101\public

# NVIDIA NIM（選用；申請：https://build.nvidia.com/）
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
